<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="800"
        Height="500"
        xmlns:vm="clr-namespace:AvaloniaUI.ViewModels"
        x:Class="AvaloniaUI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}">
</Window>
